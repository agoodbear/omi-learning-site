rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      // 管理員＝Auth custom claim admin:true（同 firestore.rules）
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // 跟 firestore.rules 的 isApproved() 同一個判準：註冊後要管理員核准（2026-11-08 起 Storage 也看這個）
    function isApproved() {
      return isAdmin() || (request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('approved', false) == true);
    }

    // Case images: approved users can upload de-identified ECG images (≤10MB, image only)
    match /cases/{caseId}/{allPaths=**} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    // Papers storage
    match /papers/{paperId}/{allPaths=**} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
