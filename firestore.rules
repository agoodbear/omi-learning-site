rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Hardcoded admin check matching client (should ideally use custom claims)
      return request.auth != null && request.auth.token.email == '16022@omi.local';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 註冊後要管理員核准（users/{uid}.approved 只有 server action 能改）
    function isApproved() {
      return isAdmin() || (isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true);
    }

    // --- Users & Profiles ---
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() ||
        (isOwner(uid) && request.resource.data.get('approved', false) == false);
      allow update: if isAdmin() ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'employeeId']));
      allow delete: if isAdmin();
    }

    // --- Core Content ---
    match /cases/{caseId} {
      // Published cases readable by approved users; pending/draft only by admin
      allow read: if isAdmin() || (isApproved() && resource.data.status == 'published');
      // Approved users may submit cases with 'pending' status
      allow create: if isAdmin() ||
        (isApproved() && request.resource.data.status == 'pending' &&
         request.resource.data.submittedBy.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /papers/{paperId} {
      allow read: if isAdmin() || (isApproved() && resource.data.status == 'published');
      allow write: if isAdmin();

      match /highlights/{highlightId} {
        allow read: if isAdmin() || (isApproved() && get(/databases/$(database)/documents/papers/$(paperId)).data.status == 'published');
        allow write: if isAdmin();
      }
    }

    // --- Analytics & Gamification ---
    // Aggregated stats are written by server actions (Admin SDK) only.

    match /userStats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /pointsStats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Leaderboard
      allow list: if isApproved();
    }

    match /userContentStatus/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /caseStats/{caseId} {
      allow read: if isApproved();
    }

    // --- Events ---
    match /events/{eventId} {
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // --- Quiz Attempts (written by server action) ---
    match /attempts/{attemptId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
    }

    // Legacy Progress (Phase 3)
    match /progress/{uid} {
      allow read: if isOwner(uid);
    }

    // --- 病人資料（病歷號、年齡、性別、ECG日期）：只有管理員 ---
    match /caseRegistry/{caseId} {
      allow read, write: if isAdmin();
    }

    // --- Research ---
    // 臨床資料（病人層級）只在本機分析，不放 Firebase。
    match /clinicalEvents/{eventId} {
      allow read, write: if false;
    }

    match /researchConfig/{configId} {
      allow read, write: if isAdmin();
    }

    // --- Social (Comments) ---
    match /comments/{commentId} {
      allow read: if isApproved();
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid;
      // 作者可改自己的留言；其他人只能動表情回應
      allow update: if isAdmin() ||
        (isApproved() && resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid) ||
        (isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
