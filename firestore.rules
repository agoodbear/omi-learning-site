rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // 管理員＝Auth custom claim admin:true（只有 Admin SDK 能設；2026-11-08 起不再認 email 字串）
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // 帳號的員工編號＝登入 email 的 @ 前段（email 由 Firebase Auth 保證唯一）
    function myEmployeeId() {
      return request.auth.token.email.split('@')[0];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 註冊後要管理員核准（users/{uid}.approved 只有 server action 能改）
    function isApproved() {
      return isAdmin() || (isLoggedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true);
    }

    // --- Users & Profiles ---
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // employeeId 必須跟登入帳號一致，不能自稱別人的員編（2026-11-08）
      allow create: if isAdmin() ||
        (isOwner(uid) && request.resource.data.get('approved', false) == false &&
         request.resource.data.get('employeeId', '') == myEmployeeId());
      allow update: if isAdmin() ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'employeeId']));
      allow delete: if isAdmin();
    }

    // --- Core Content ---
    match /cases/{caseId} {
      // Published cases readable by approved users; pending/draft only by admin
      allow read: if isAdmin() || (isApproved() && resource.data.status == 'published');
      // Approved users may submit cases with 'pending' status
      allow create: if isAdmin() ||
        (isApproved() && request.resource.data.status == 'pending' &&
         request.resource.data.submittedBy.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /papers/{paperId} {
      allow read: if isAdmin() || (isApproved() && resource.data.status == 'published');
      allow write: if isAdmin();

      match /highlights/{highlightId} {
        allow read: if isAdmin() || (isApproved() && get(/databases/$(database)/documents/papers/$(paperId)).data.status == 'published');
        allow write: if isAdmin();
      }
    }

    // --- Analytics & Gamification ---
    // Aggregated stats are written by server actions (Admin SDK) only.

    match /userStats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /pointsStats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Leaderboard
      allow list: if isApproved();
    }

    match /userContentStatus/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /caseStats/{caseId} {
      allow read: if isApproved();
    }

    // --- Events ---
    match /events/{eventId} {
      allow create: if isApproved() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // --- Quiz Attempts (written by server action) ---
    match /attempts/{attemptId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
    }

    // Legacy Progress (Phase 3)
    match /progress/{uid} {
      allow read: if isOwner(uid);
    }

    // --- 病人資料（病歷號、年齡、性別、ECG日期）：只有管理員 ---
    match /caseRegistry/{caseId} {
      allow read, write: if isAdmin();
    }

    // --- Research ---
    // 臨床資料（病人層級）只在本機分析，不放 Firebase。
    match /clinicalEvents/{eventId} {
      allow read, write: if false;
    }

    match /researchConfig/{configId} {
      allow read, write: if isAdmin();
    }

    // --- Social (Comments) ---
    // 表情只有四種；每次只能把「自己」加進或移出某個表情的名單（2026-11-08）
    function reactionOk(e) {
      let after = request.resource.data.reactions;
      let before = resource.data.get('reactions', {});
      return (e in after)
        ? (after[e] is list && after[e].size() <= 500 &&
           after[e].toSet().difference(before.get(e, []).toSet()).hasOnly([request.auth.uid]) &&
           before.get(e, []).toSet().difference(after[e].toSet()).hasOnly([request.auth.uid]))
        // 整個表情被拿掉：原本名單只能是自己一個人
        : (!(e in before) || before[e] == [request.auth.uid]);
    }
    function reactionsAllOk() {
      let after = request.resource.data.reactions;
      return after is map && after.keys().hasOnly(['👍', '❤️', '🔥', '😮']) &&
        reactionOk('👍') && reactionOk('❤️') && reactionOk('🔥') && reactionOk('😮');
    }

    match /comments/{commentId} {
      allow read: if isApproved();
      // 顯示名稱 userEmail 必須是自己的員編，不能冒用別人
      allow create: if isApproved() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['caseId', 'userId', 'userEmail', 'content', 'createdAt', 'reactions']) &&
        request.resource.data.get('userEmail', '') == myEmployeeId() &&
        request.resource.data.get('reactions', {}) == {} &&
        request.resource.data.content is string && request.resource.data.content.size() <= 5000;
      // 作者可改自己的留言內容（不能改顯示名稱）；其他人只能動表情回應
      allow update: if isAdmin() ||
        (isApproved() && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']) &&
         request.resource.data.content is string && request.resource.data.content.size() <= 5000) ||
        (isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
         reactionsAllOk());
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
